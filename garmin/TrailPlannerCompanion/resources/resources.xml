    <fitContributions>
        <!-- v2.1.2 : REFONTE COMPLÈTE (20 champs, voir matrice fournie par l'utilisateur).
             Chaque champ n'est réellement créé à l'exécution que si son toggle dédié
             (Application.Properties, réglable uniquement depuis Garmin Connect) est actif —
             tous les IDs possibles sont néanmoins déclarés ici. Pour les paires allure/vitesse
             (1/2, 5-8, 12-15), un seul des deux champs de chaque paire est créé selon
             pace_unit_prop ; pas de "precision" pour ces champs à type non fixe (STRING en
             mn/km, FLOAT en km/h), comme pour les autres champs dynamiques du fichier. -->
        <!-- RECORD (IDs 1-4) — displayInChart (pas displayInActivitySummary, réservé aux
             valeurs SESSION uniques) pour que Connect affiche la série temporelle en graphique -->
        <fitField id="1"  dataLabel="@Strings.label_eff_generic"        unitLabel="@Strings.unite_min_km" precision="2" sortOrder="0" displayInChart="true" chartTitle="@Strings.label_eff_generic" fillColor="FF6600"/>
        <fitField id="2"  dataLabel="@Strings.label_eff_speed_kmh"      unitLabel="@Strings.unite_km_h" precision="1" sortOrder="1" displayInChart="true" chartTitle="@Strings.label_eff_speed_kmh" fillColor="0066FF"/>
        <fitField id="3"  dataLabel="@Strings.label_fit_temp_bag_corr"  unitLabel="@Strings.unite_pct" precision="1" sortOrder="2" displayInChart="true" chartTitle="@Strings.label_fit_temp_bag_corr" fillColor="00AA55"/>
        <fitField id="4"  dataLabel="@Strings.label_fit_bag_kg"         unitLabel="@Strings.unite_kg"   precision="0" sortOrder="3" displayInChart="true" chartTitle="@Strings.label_fit_bag_kg" fillColor="AA00AA"/>
        <!-- CYCLE / LAP (IDs 5-11) -->
        <fitField id="5"  dataLabel="@Strings.label_fit_avg_pace_std"   unitLabel="@Strings.unite_min_km" sortOrder="4" displayInActivityLaps="true"/>
        <fitField id="6"  dataLabel="@Strings.label_fit_avg_pace_mtn"   unitLabel="@Strings.unite_min_km" sortOrder="5" displayInActivityLaps="true"/>
        <fitField id="7"  dataLabel="@Strings.label_fit_avg_speed_std"  unitLabel="@Strings.unite_km_h" precision="1" sortOrder="6" displayInActivityLaps="true"/>
        <fitField id="8"  dataLabel="@Strings.label_fit_avg_speed_mtn"  unitLabel="@Strings.unite_km_h" precision="1" sortOrder="7" displayInActivityLaps="true"/>
        <fitField id="9"  dataLabel="@Strings.label_fit_effort_dist"    unitLabel="@Strings.unite_km"   precision="1" sortOrder="8" displayInActivityLaps="true"/>
        <fitField id="10" dataLabel="@Strings.label_fit_bag_kg"         unitLabel="@Strings.unite_kg"   precision="0" sortOrder="9" displayInActivityLaps="true"/>
        <fitField id="11" dataLabel="@Strings.label_fit_lap_vam"        unitLabel="@Strings.unite_m_h"  precision="0" sortOrder="10" displayInActivityLaps="true"/>
        <!-- SESSION (IDs 12-20) -->
        <fitField id="12" dataLabel="@Strings.label_fit_avg_pace_std"   unitLabel="@Strings.unite_min_km" sortOrder="11" displayInActivitySummary="true"/>
        <fitField id="13" dataLabel="@Strings.label_fit_avg_pace_mtn"   unitLabel="@Strings.unite_min_km" sortOrder="12" displayInActivitySummary="true"/>
        <fitField id="14" dataLabel="@Strings.label_fit_avg_speed_std"  unitLabel="@Strings.unite_km_h" precision="1" sortOrder="13" displayInActivitySummary="true"/>
        <fitField id="15" dataLabel="@Strings.label_fit_avg_speed_mtn"  unitLabel="@Strings.unite_km_h" precision="1" sortOrder="14" displayInActivitySummary="true"/>
        <fitField id="16" dataLabel="@Strings.label_fit_effort_dist"    unitLabel="@Strings.unite_km"   precision="1" sortOrder="15" displayInActivitySummary="true"/>
        <fitField id="17" dataLabel="@Strings.label_fit_temp_corr"      unitLabel="@Strings.unite_vide" precision="0" sortOrder="16" displayInActivitySummary="true"/>
        <fitField id="18" dataLabel="@Strings.label_fit_bag_kg"         unitLabel="@Strings.unite_kg"   precision="0" sortOrder="17" displayInActivitySummary="true"/>
        <fitField id="19" dataLabel="@Strings.label_fit_climb_coeff"    unitLabel="@Strings.unite_mult" precision="1" sortOrder="18" displayInActivitySummary="true"/>
        <fitField id="20" dataLabel="@Strings.label_fit_descent_coeff"  unitLabel="@Strings.unite_mult" precision="1" sortOrder="19" displayInActivitySummary="true"/>
    </fitContributions>
</resources>

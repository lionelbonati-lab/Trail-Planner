<settings>
    <setting propertyKey="@Properties.code" title="@Strings.CodeTitle" prompt="@Strings.CodePrompt">
        <settingConfig type="alphaNumeric" />
    </setting>
    <setting propertyKey="@Properties.zoom" title="@Strings.ZoomTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.ZoomAll</listEntry>
            <listEntry value="1">@Strings.Zoom20</listEntry>
            <listEntry value="2">@Strings.Zoom10</listEntry>
            <listEntry value="3">@Strings.Zoom5</listEntry>
            <listEntry value="4">@Strings.Zoom2</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.slopes" title="@Strings.SlopesPrompt">
        <settingConfig type="boolean" />
    </setting>
</settings>

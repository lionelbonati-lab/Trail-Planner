<!-- settings.xml — EndurancePro 2.7.3 + appli Trail Planner Companion, dans l'ordre des dossiers du menu de
     la montre (Affichage, Colorisation, Circuit, Allure, Alarmes, Propriétés), puis l'enregistrement FIT. -->
<!-- v1.9.45 : Tous les réglages migrés vers le menu on-watch (getSettingsView, voir
     EnduranceProSettingsMenu.mc). v2.1.2 : lissage (buffer_size_prop) et unité d'allure
     (pace_unit_prop, AFFICHAGE montre, modifiable en course) migrés à leur tour vers le
     dossier "Propriétés" on-watch. Refonte complète des champs FIT (voir matrice) : 8
     toggles ON/OFF + 1 unité (fit_pace_unit_prop, ENREGISTREMENT FIT — volontairement
     indépendante de pace_unit_prop), gérés exclusivement depuis Garmin Connect (pas de
     version on-watch) — modifiables tant que l'activité n'est pas démarrée (voir
     EnduranceProApp.onSettingsChanged()). v2.1.4 : fit_enabled_prop (toggle global FIT)
     retiré — redondant avec les 8 toggles dédiés qui gardent déjà chaque champ. v2.2.9 :
     tentative de retrait de fit_pace_unit_prop (allure+vitesse toujours ensemble) → deux
     crashs successifs (STRING interdit sur RECORD, puis "Out of memory" à 20 champs
     combinés) — picker rétabli, comportement identique à la v2.2.8. -->
<resources>
    <settings>

        <!-- Affichage (dossier Affichage de la montre) : écrans Profil, Trail Planner et Carte de l'appli -->
        <setting propertyKey="@Properties.zoom" title="@Strings.tp_zoom">
            <settingConfig type="list">
                <listEntry value="0">@Strings.tp_zoom_all</listEntry>
                <listEntry value="1">@Strings.tp_zoom_20</listEntry>
                <listEntry value="2">@Strings.tp_zoom_10</listEntry>
                <listEntry value="3">@Strings.tp_zoom_5</listEntry>
                <listEntry value="4">@Strings.tp_zoom_2</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.finishStats" title="@Strings.tp_finish_prompt">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.mapScale" title="@Strings.tp_map_scale">
            <settingConfig type="list">
                <listEntry value="0">200 m</listEntry>
                <listEntry value="1">500 m</listEntry>
                <listEntry value="2">1 km</listEntry>
                <listEntry value="3">2 km</listEntry>
                <listEntry value="4">5 km</listEntry>
            </settingConfig>
        </setting>

        <!-- Colorisation : profil coloré selon la pente -->
        <setting propertyKey="@Properties.slopes" title="@Strings.tp_slopes_prompt">
            <settingConfig type="boolean" />
        </setting>

        <!-- Circuit : tour = passage au point -->
        <setting propertyKey="@Properties.lapPass" title="@Strings.tp_lap_pass_prompt">
            <settingConfig type="boolean" />
        </setting>

        <!-- Allure : référence d'allure et bornes des zones VC (aussi réglables / synchronisées sur la montre) -->
        <setting propertyKey="@Properties.pace_ref_prop" title="@Strings.set_pace_ref">
            <settingConfig type="list">
                <listEntry value="0">@Strings.set_target_pace</listEntry>
                <listEntry value="1">@Strings.opt_ref_vc</listEntry>
                <listEntry value="2">@Strings.opt_ref_vc_pct</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.vc_zones_prop" title="@Strings.set_vc_zones">
            <settingConfig type="alphaNumeric" />
        </setting>

        <!-- Alarmes : rappels nutrition et vibrations des rappels Trail Planner -->
        <setting propertyKey="@Properties.fuelMin" title="@Strings.tp_fuel_prompt">
            <settingConfig type="numeric" min="-1" max="120" />
        </setting>

        <setting propertyKey="@Properties.vibrate" title="@Strings.tp_vibrate">
            <settingConfig type="boolean" />
        </setting>

        <!-- Propriétés : code Trail Planner (code à 8 chiffres du site : plan, parcours, réglages, suivi) -->
        <setting propertyKey="@Properties.trail_code_prop" title="@Strings.set_trail_code">
            <settingConfig type="alphaNumeric" />
        </setting>

        <!-- Enregistrement FIT (téléphone seulement, voir l'en-tête) -->
        <setting propertyKey="@Properties.fit_pace_unit_prop" title="@Strings.set_fit_pace_unit">
            <settingConfig type="list">
                <listEntry value="0">min/km</listEntry>
                <listEntry value="1">km/h</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.fit_pace_speed_prop" title="@Strings.set_fit_pace_speed">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.fit_temp_bag_corr_prop" title="@Strings.set_fit_temp_bag_corr">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.fit_bag_weight_prop" title="@Strings.set_fit_bag_weight">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.fit_avg_pace_speed_prop" title="@Strings.set_fit_avg_pace_speed">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.fit_effort_dist_prop" title="@Strings.set_fit_effort_dist">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.fit_vam_lap_prop" title="@Strings.set_fit_vam_lap">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.fit_temp_coeff_prop" title="@Strings.set_fit_temp_coeff">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.fit_coefficients_prop" title="@Strings.set_fit_coefficients">
            <settingConfig type="boolean" />
        </setting>

    </settings>
</resources>

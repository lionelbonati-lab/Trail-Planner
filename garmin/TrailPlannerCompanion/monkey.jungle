project.manifest = manifest.xml

# Comme EndurancePro : sans ces lignes, le sourcePath par défaut du SDK est tout le projet et les
# fichiers layouts/ seraient compilés ensemble (module DeviceLayout en double). Chaque montre reçoit
# la mise en page EndurancePro de sa résolution (layouts/) et ses polices d'icônes (resources-WxH).
base.sourcePath = source
base.resourcePath = resources

# Écran Carte : fond de carte Garmin (WatchUi.MapView, code annoté (:map)) sur les montres à cartes ;
# tracé seul (code (:nomap)) sur les autres. Si la compilation d'une montre échoue sur MapView, lui
# ajouter une ligne « <montre>.excludeAnnotations = map » comme ci-dessous.
base.excludeAnnotations = nomap
fr255.excludeAnnotations = map
fr265.excludeAnnotations = map

# ── 240×240 MIP ───────────────────────────────────────────────────────────────────────────
fenix6spro.resourcePath         = resources;resources-240x240
fenix6spro.sourcePath           = source;layouts/Layout_240x240.mc
fenix7s.resourcePath            = resources;resources-240x240
fenix7s.sourcePath              = source;layouts/Layout_240x240.mc
fenix7spro.resourcePath         = resources;resources-240x240
fenix7spro.sourcePath           = source;layouts/Layout_240x240.mc


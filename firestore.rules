rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque utilisateur ne lit et n'écrit que ses propres données.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Liens d'assistance : lisibles par quiconque a le lien (identifiant aléatoire),
    // modifiables uniquement par leur propriétaire.
    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    // Suivi envoyé par la montre (sans compte) : seulement pour un code montre existant,
    // et seulement ces champs, avec des types et tailles limités.
    match /live/{code} {
      allow read: if true;
      allow write: if exists(/databases/$(database)/documents/shares/$(code))
                   && request.resource.data.keys().hasOnly(['t', 's', 'd', 'lat', 'lon', 'bat', 'p', 'v'])
                   && request.resource.data.t is int
                   && request.resource.data.s is int
                   && request.resource.data.d is int
                   && (!('p' in request.resource.data) || (request.resource.data.p is string && request.resource.data.p.size() < 2000))
                   && (!('lat' in request.resource.data) || request.resource.data.lat is number)
                   && (!('lon' in request.resource.data) || request.resource.data.lon is number)
                   && (!('bat' in request.resource.data) || request.resource.data.bat is int);
    }
    // Message de l'assistance vers la montre (sans compte, comme le lien d'assistance) : pour un code
    // montre existant, texte court, un message par minute au plus. La montre n'y écrit que ses accusés
    // « reçu » (got) et « lu » (read), pour le même message (id inchangé).
    match /msg/{code} {
      function sent() {
        return request.resource.data.keys().hasOnly(['id', 'text', 't', 'at'])
          && request.resource.data.id is string
          && request.resource.data.id.size() >= 4
          && request.resource.data.id.size() <= 24
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 60
          && request.resource.data.t is int
          && request.resource.data.at == request.time;
      }
      function acked() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['got', 'read'])
          && (!('got' in request.resource.data) || request.resource.data.got is int)
          && (!('read' in request.resource.data) || request.resource.data.read is int);
      }
      allow read: if true;
      allow create: if exists(/databases/$(database)/documents/shares/$(code)) && sent();
      allow update: if exists(/databases/$(database)/documents/shares/$(code))
                    && ((sent() && request.time > resource.data.at + duration.value(60, 's')) || acked());
    }
    // Trace d'une sortie libre (rien sur la montre), écrite par le serveur : lisible comme le relevé.
    match /live/{code}/track/{id} {
      allow read: if true;
      allow write: if false;
    }
    // Abonnements aux notifications d'un lien (assistance « share:<id> », lien permanent « suivi:<code> »),
    // sans compte : un jeton de téléphone par document, pour un lien existant. Lus par le serveur seul ;
    // l'identifiant du document vient du jeton (introuvable sans lui).
    match /push/{id} {
      allow read: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['token', 'target', 'ref', 'at'])
                            && request.resource.data.token is string
                            && request.resource.data.token.size() > 20
                            && request.resource.data.token.size() < 1000
                            && request.resource.data.ref is string
                            && request.resource.data.ref.size() < 120
                            && request.resource.data.target in ['share:' + request.resource.data.ref, 'suivi:' + request.resource.data.ref]
                            && request.resource.data.at is int
                            && exists(/databases/$(database)/documents/shares/$(request.resource.data.ref));
      allow delete: if true;
    }
    // Ce qui a déjà été notifié (serveur seul).
    match /push_state/{id} {
      allow read, write: if false;
    }
  }
}

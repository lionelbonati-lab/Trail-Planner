rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque utilisateur ne lit et n'écrit que ses propres données.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Liens d'assistance : lisibles par quiconque a le lien (identifiant aléatoire),
    // modifiables uniquement par leur propriétaire.
    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    // Suivi envoyé par la montre (sans compte) : seulement pour un code montre existant,
    // et seulement ces champs, avec des types et tailles limités.
    match /live/{code} {
      allow read: if true;
      allow write: if exists(/databases/$(database)/documents/shares/$(code))
                   && request.resource.data.keys().hasOnly(['t', 's', 'd', 'lat', 'lon', 'bat', 'p', 'v'])
                   && request.resource.data.t is int
                   && request.resource.data.s is int
                   && request.resource.data.d is int
                   && (!('p' in request.resource.data) || (request.resource.data.p is string && request.resource.data.p.size() < 2000))
                   && (!('lat' in request.resource.data) || request.resource.data.lat is number)
                   && (!('lon' in request.resource.data) || request.resource.data.lon is number)
                   && (!('bat' in request.resource.data) || request.resource.data.bat is int);
    }
  }
}

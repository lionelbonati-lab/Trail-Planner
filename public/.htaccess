# Hébergement Apache (Infomaniak) : la page, le service worker et le manifeste toujours revérifiés
# (mises à jour visibles tout de suite) ; les fichiers à empreinte (assets/) gardés en cache un an.
# Ignoré par GitHub Pages.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
DirectoryIndex index.html

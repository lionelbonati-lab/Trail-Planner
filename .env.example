# Synchronisation Firebase (facultatif). Sans ces valeurs, stockage local dans le navigateur.
# Valeurs de la « configuration web » du projet Firebase (elles ne sont pas secrètes).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Notifications push : clé publique « certificat Web Push » (Cloud Messaging), voir docs/notifications.md.
VITE_FIREBASE_VAPID_KEY=
